    </div>
    <div class="sugg" id="sugg"></div>
    <div class="fb ${fbCls}" id="fb" aria-live="polite">${esc(fbMsg)}</div>
    ${S.tried.length?`<div class="tried" aria-label="Wrong answers">${S.tried.map(t=>`<span>${esc(t)}</span>`).join('')}</div>`:''}
  </form>
  <div id="giveup"></div>`;
  fbMsg=''; fbCls=''; fresh=-1;
  app.querySelectorAll('button.sq').forEach(b=>onPress(b,()=>{ sel=+b.dataset.i; game(); const i=document.getElementById('gin'); if(i) i.focus({preventScroll:true}); }));
  const inp=document.getElementById('gin');
  inp.addEventListener('input',()=>{ const box=document.getElementById('sugg'); box.innerHTML=suggest(inp.value).map(n=>`<button type="button" data-n="${esc(n)}">${esc(n)}</button>`).join('');
    box.querySelectorAll('button').forEach(b=>onPress(b,()=>{ inp.value=b.dataset.n; play(); })); });
  document.getElementById('ask').addEventListener('submit',e=>{ e.preventDefault(); play(); });
  drawGiveUp();
}
function say(m,cls){ const f=document.getElementById('fb'); if(f){ f.className='fb '+cls; f.textContent=m; } }
function play(){
  if(sel<0||S.over) return;
  const inp=document.getElementById('gin'), raw=inp.value.trim(); if(!raw) return;
  const hits=find(raw);
  if(!hits.length){ say(`We don't have ${raw} on our books yet. No life lost, try another.`,'warn'); inp.select(); return; }
  if(hits.length>1){ say('More than one player fits that name. Use his full name.','warn'); inp.select(); return; }
  const p=hits[0];
  if(S.cells.includes(p.name)){ say(`${p.name} is already on the grid. Each player can only be used once.`,'warn'); inp.select(); return; }
  const r=Math.floor(sel/3), c=sel%3, a=test(p,G.r[r]), b=test(p,G.c[c]);
  if(a===true && b===true){ S.cells[sel]=p.name; fresh=sel; sel=-1;
    if(filled()===9){ S.over=true; save(); fbMsg=''; game(); setTimeout(result,700); return; }
    save(); fbMsg=`${p.name}. ${9-filled()} squares to go.`; fbCls='good'; game(); return; }
  if(a===false || b===false){
    S.tried.push(p.name); S.lost++;
    const reason = a===false ? why(p,G.r[r]) : why(p,G.c[c]);
    if(S.lost>=LIVES){ S.over=true; save(); result(); return; }
    save(); const left=LIVES-S.lost; fbMsg=`${reason}. ${left===1?'Last life left.':left+' lives left.'}`; fbCls=left===1?'warn':'bad'; game(); return;
  }
  say(`We can't confirm that one for ${p.name} yet. No life lost, try another.`,'warn'); inp.select();
}
function drawGiveUp(){
  const g=document.getElementById('giveup'); if(!g) return;
  g.innerHTML = confirmOpen ? `<div class="confirm"><p>Are you sure? Giving up ends today's game on 0 points and reveals the answer.</p>
    <div class="actions"><button class="btn ghost" id="keep">Keep playing</button><button class="btn danger" id="quit">Give up</button></div></div>`
    : `<div style="display:flex;justify-content:center"><button class="linkbtn" id="gu">Give up</button></div>`;
  if(confirmOpen){ onPress(document.getElementById('keep'),()=>{confirmOpen=false;drawGiveUp();}); onPress(document.getElementById('quit'),()=>{confirmOpen=false;S.over=true;S.gaveUp=true;save();result();}); }
  else onPress(document.getElementById('gu'),()=>{confirmOpen=true;drawGiveUp();});
}

/* ---------- result ---------- */
function verdict(s){
  if(S.gaveUp) return 'Gave up';
  const f=filled();
  if(f===9) return S.lost? 'Full grid' : 'Total football';
  if(f>=7) return 'Nearly there';
  if(f>=4) return 'Half a grid';
  if(f>=1) return 'A few touches';
  return 'Never got on the ball';
}
function inviteUrl(){ return `${GAME_URL}#c${dayNo}-${score()}`; }
function inviteText(){
  const rows=[0,1,2].map(r=>[0,1,2].map(c=>S.cells[r*3+c]?'🟩':'🟥').join('')).join('\n');
  const head = S.gaveUp ? `⚽ Tiki-Taka-Toe No. ${dayNo}: 🏳️ gave up (0/100)` : `⚽ Tiki-Taka-Toe No. ${dayNo}: ${filled()}/9 for ${score()}/100`;
  return `${head}\n${rows}\n\nA 3×3 football grid. Can you fill more squares?\nTry today's grid: ${inviteUrl()}`;
}
let cdTimer=0;
function result(){
  const s=score();
  let vs='';
  if(challenge!==null){ const d=s-challenge; vs=`<div class="vs">Your friend: <b>${challenge}</b> · ${d>0?`You win by <b>${d}</b>`:d<0?`They win by <b>${-d}</b>`:'<b>Level</b>, a draw'}</div>`; }
  app.innerHTML = `
  <section class="card enter">
    <div class="inner">
      <span class="eyebrow">Full time · No. ${dayNo}</span>
      ${S.gaveUp?'<span class="flag">Gave up</span>':''}
      <div class="score"><b id="scr">0</b><span>/ 100</span></div>
      <p class="verdict">${verdict(s)}</p>
      ${vs}
    </div>
    ${gridHTML(true)}
    <div class="legend"><span><i style="background:var(--accent)"></i>Your answer</span><span><i style="background:color-mix(in oklab,var(--bad) 18%,var(--bg))"></i>Missed: one player who fits</span></div>
  </section>
  ${typeof tdkoStreakCard==='function'?tdkoStreakCard('tiki-taka-toe'):''}
  <section class="card sharecard"><div class="inner share">
    <h3>Challenge a friend</h3>
    <img id="cardimg" alt="Tiki-Taka-Toe share card showing a score of ${s} out of 100">
    <p>Your friend gets today's grid with your score as the one to beat. The card never shows the players.</p>
    <button class="btn" id="shareBtn">Challenge a friend</button>
    <div class="sendto" id="sendto" hidden>
      <span class="eyebrow">Send with</span>
      <div class="targets">
        <a class="tgt wa" id="t-wa" target="_blank" rel="noopener">WhatsApp</a>
        <a class="tgt" id="t-x" target="_blank" rel="noopener">X</a>
        <a class="tgt" id="t-tg" target="_blank" rel="noopener">Telegram</a>
        <a class="tgt" id="t-fb" target="_blank" rel="noopener">Facebook</a>
      </div>
      <button class="linkbtn" id="copyInvite">Or copy the invite</button>
    </div>
  </div></section>
  ${tdkoReplayBox(REPLAY)}
  <div class="next"><span class="eyebrow">Next grid in</span><b id="cd">--:--:--</b></div>`;
  const el=document.getElementById('scr'), t0=performance.now(), reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  (function up(){const p=reduce?1:Math.min(1,(performance.now()-t0)/800); el.textContent=Math.round(s*(1-Math.pow(1-p,3))); if(p<1) requestAnimationFrame(up)})();
  let cardBlob=null;
  drawCard().then(b=>{ cardBlob=b; if(b) document.getElementById('cardimg').src=URL.createObjectURL(b); });
  const full=inviteText(), url=inviteUrl(), noUrl=full.replace(/\nTry today's grid: .*$/,'\nTry today\'s grid:'), E=encodeURIComponent;
  document.getElementById('t-wa').href=`https://wa.me/?text=${E(full)}`;
  document.getElementById('t-x').href=`https://x.com/intent/post?text=${E(noUrl)}&url=${E(url)}`;
  document.getElementById('t-tg').href=`https://t.me/share/url?url=${E(url)}&text=${E(noUrl)}`;
  document.getElementById('t-fb').href=`https://www.facebook.com/sharer/sharer.php?u=${E(url)}`;
  const sendto=document.getElementById('sendto');
  const showTargets=()=>{ sendto.hidden=false; sendto.scrollIntoView({block:'nearest',behavior:reduce?'auto':'smooth'}); };
  document.getElementById('shareBtn').addEventListener('click', async ()=>{
    if(!navigator.share) return showTargets();
    const data={title:'Tiki-Taka-Toe', text:full};
    try{ const f=cardBlob&&new File([cardBlob],`tiki-taka-toe-${dayNo}.png`,{type:'image/png'}); if(f&&navigator.canShare&&navigator.canShare({files:[f]})) data.files=[f]; }catch(e){}
    try{ await navigator.share(data); }catch(e){ if(e&&e.name==='AbortError') return; showTargets(); }
  });
  document.getElementById('copyInvite').addEventListener('click', ()=>{
    const fb=()=>{ const t=document.createElement('textarea'); t.className='copybox'; t.readOnly=true; t.value=full; document.getElementById('copyInvite').replaceWith(t); t.focus(); t.select(); toast('Select the text and copy it'); };
    try{ navigator.clipboard.writeText(full).then(()=>toast('Invite copied. Paste it to a friend'),fb); }catch(e){ fb(); }
  });
  clearInterval(cdTimer);
  const tick=()=>{const n=new Date(),mid=new Date(n);mid.setHours(24,0,0,0);const d=Math.max(0,(mid-n)/1000|0);
    if(d===0){ clearInterval(cdTimer); return location.reload(); }
    const c=document.getElementById('cd'); if(c) c.textContent=`${String(d/3600|0).padStart(2,'0')}:${String(d%3600/60|0).padStart(2,'0')}:${String(d%60).padStart(2,'0')}`;};
  tick(); cdTimer=setInterval(tick,1000);
}

/* ---------- share card (1080×1080: 3×3 of filled and missed squares, never names) ---------- */
async function drawCard(){
  try{ await Promise.all([document.fonts.load('900 100px Archivo'),document.fonts.load('800 40px Archivo'),document.fonts.load('600 30px "IBM Plex Mono"')]); }catch(e){}
  const W=1080, c=document.createElement('canvas'); c.width=c.height=W;
  const x=c.getContext('2d'); if(!x) return null;
  const K={bg:'#0B110E',ink:'#EAF0EC',muted:'#8A988F',line:'#24302A',acc:'#34D27F',bad:'#FF6B5A'};
  const cond=v=>{ if('fontStretch' in x) x.fontStretch=v; };
  const Pd=80, s=score();
  x.fillStyle=K.bg; x.fillRect(0,0,W,W);
  cond('condensed'); x.font='900 60px Archivo,"Arial Narrow",sans-serif'; x.fillStyle=K.ink;
  x.fillText('TIKI-TAKA-',Pd,Pd+50); const w=x.measureText('TIKI-TAKA-').width; x.fillStyle=K.acc; x.fillText('TOE',Pd+w,Pd+50);
  cond('normal'); x.font='600 24px "IBM Plex Mono",monospace'; x.fillStyle=K.muted; x.textAlign='right';
  x.fillText(`NO. ${dayNo} · ${dateLabel.toUpperCase()}`,W-Pd,Pd+46); x.textAlign='left';
  x.fillStyle=K.ink; x.fillRect(Pd,Pd+80,W-2*Pd,4);
  x.font='600 28px "IBM Plex Mono",monospace'; x.fillStyle=K.muted; x.fillText(S.gaveUp?'I GAVE UP TODAY':`I FILLED ${filled()} OF 9 FOR`,Pd,Pd+170);
  cond('condensed'); x.font='900 300px Archivo,"Arial Narrow",sans-serif'; x.fillStyle=K.ink;
  const sw=x.measureText(String(s)).width; x.fillText(String(s),Pd-8,Pd+430);
  cond('normal'); x.font='600 44px "IBM Plex Mono",monospace'; x.fillStyle=K.muted; x.fillText('/100',Pd+sw+10,Pd+430);
  cond('condensed'); x.font='800 46px Archivo,"Arial Narrow",sans-serif'; x.fillStyle=(s&&!S.gaveUp)?K.acc:K.bad; x.fillText(verdict(s).toUpperCase(),Pd,Pd+500);
  const cell=96, gap=12, gx=W-Pd-3*cell-2*gap, gy=Pd+150;
  for(let i=0;i<9;i++){ x.fillStyle=S.cells[i]?K.acc:K.bad; x.fillRect(gx+(i%3)*(cell+gap), gy+Math.floor(i/3)*(cell+gap), cell, cell); }
  const by=W-Pd-20;
  cond('condensed'); x.font='800 46px Archivo,"Arial Narrow",sans-serif'; x.fillStyle=K.ink; x.fillText('CAN YOU FILL THE GRID?',Pd,by-46);
  cond('normal'); x.font='500 24px "IBM Plex Mono",monospace'; x.fillStyle=K.muted; x.fillText('A 3×3 FOOTBALL GRID · FIVE LIVES · ONE GO A DAY',Pd,by);
  return new Promise(r=>c.toBlob(b=>r(b),'image/png'));
}

/* ---------- day rollover: always the player's own calendar day. If the page is left open past midnight, load the new day's puzzle when they come back. ---------- */
const openedOn = (d=>`${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`)(new Date());
const rollCheck = () => { const d=new Date(); if(`${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`!==openedOn) location.reload(); };
document.addEventListener('visibilitychange', ()=>{ if(!document.hidden) rollCheck(); });
addEventListener('focus', rollCheck);

/* ---------- boot ---------- */
if(S.over) result(); else if(S.started) game(); else intro();
})();
</script>
