/* ---------- game ---------- */
let sel=-1, fbMsg='', fbCls='', confirmOpen=false, fresh=-1;
function gridHTML(final){
  let h=`<div class="grid" role="grid" aria-label="Three by three grid"><div class="corner">${final?'':'Tap a<br>square'}</div>`;
  h+=G.cl.map(c=>`<div class="clue col" title="${esc(c)}">${esc(short(c))}</div>`).join('');
  for(let r=0;r<3;r++){
    h+=`<div class="clue row" title="${esc(G.rl[r])}">${esc(short(G.rl[r]))}</div>`;
    for(let c=0;c<3;c++){ const i=r*3+c, v=S.cells[i];
      if(v) h+=`<div class="sq ok${i===fresh?' new':''}" role="gridcell" aria-label="${esc(G.rl[r])} and ${esc(G.cl[c])}: ${esc(v)}"><b>${esc(surname(v))}</b></div>`;
      else if(final) h+=`<div class="sq rev" role="gridcell" aria-label="${esc(G.rl[r])} and ${esc(G.cl[c])}: missed, for example ${esc(G.ex[i])}"><small>e.g.</small><b>${esc(surname(G.ex[i]))}</b></div>`;
      else h+=`<button class="sq${i===sel?' sel':''}" data-i="${i}" aria-label="${esc(G.rl[r])} and ${esc(G.cl[c])}"><span class="q">?</span></button>`;
    }
  }
  return h+'</div>';
}
function game(){
  if(S.over) return result();
  const lost=S.lost;
  const r=Math.floor(sel/3), c=sel%3;
  app.innerHTML = `
  <section class="card">
    <div class="status">
      <div class="lives" aria-label="${LIVES-lost} lives left"><span class="eyebrow" style="margin-right:4px">Lives</span>${Array.from({length:LIVES},(_,k)=>`<span class="life${k>=LIVES-lost?' used':''}"></span>`).join('')}</div>
      <div class="pts"><b>${filled()}/9</b><small>squares</small></div>
    </div>
    ${gridHTML(false)}
  </section>
  <form class="ask" id="ask" autocomplete="off">
    <div class="for">${sel<0?'Pick a square, then name a player who fits it.':`Who played for <b>${esc(G.rl[r])}</b> and fits <b>${esc(G.cl[c])}</b>?`}</div>
    <div class="grow">
      <input id="gin" type="text" autocapitalize="words" spellcheck="false" placeholder="${sel<0?'Pick a square first':'Type a player'}" aria-label="Player name" ${sel<0?'disabled':''}>
