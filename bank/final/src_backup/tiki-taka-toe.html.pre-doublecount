let S = load() || {started:false, cells:Array(9).fill(null), tried:[], lost:0, over:false, gaveUp:false};
const filled = () => S.cells.filter(Boolean).length;
const score = () => S.gaveUp ? 0 : Math.round(filled()*100/9);
const esc = s => String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const surname = n => { const w=n.split(' '); return w.length>1 ? w.slice(1).join(' ') : n; };

/* ---------- judging ---------- */
const BY = {}; PLAYERS.forEach(p=>BY[p.name]=p);
function test(p, c){ // true / false / null (not confirmed)
  const [k,v]=c;
  if(k==='club') return p.clubs.includes(v);
  if(k==='nat') return p.nat===v;
  if(k==='hon') return p[v];
  if(k==='league') return p.clubs.some(x=>LEAGUES[v].includes(x));
}
function why(p, c){
  const [k,v]=c;
  if(k==='club') return `${p.name} never played for ${v}`;
  if(k==='nat') return `${p.name} played for ${p.nat}, not ${v}`;
  if(k==='hon') return `${p.name} never ${HON[v]}`;
  if(k==='league') return `${p.name} never played in ${({MLS:'MLS',SAU:'the Saudi Pro League',ITA:'Serie A'})[v]}`;
}
const norm = s => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/ı/g,'i').replace(/[-'.]/g,' ').replace(/[^a-z ]/g,'').replace(/\s+/g,' ').trim();
const IDX = PLAYERS.map(p=>({p, f:norm(p.name), s:norm(surname(p.name))}));
function lev(a,b){ const d=Array.from({length:b.length+1},(_,i)=>i);
  for(let i=1;i<=a.length;i++){ let q=d[0]; d[0]=i; for(let j=1;j<=b.length;j++){ const t=d[j]; d[j]=Math.min(d[j]+1,d[j-1]+1,q+(a[i-1]===b[j-1]?0:1)); q=t; } } return d[b.length]; }
function find(raw){ // exact full name, unique surname, or a close spelling of either
  const g=norm(raw); if(g.length<3) return [];
  let hit=IDX.filter(x=>x.f===g); if(hit.length) return hit.map(x=>x.p);
  hit=IDX.filter(x=>x.s===g); if(hit.length) return hit.map(x=>x.p);
  const sl=s=>s.length>=9?2:s.length>=5?1:0;
  return IDX.filter(x=>lev(g,x.f)<=sl(x.f) || (x.s.length>=5 && lev(g,x.s)<=sl(x.s))).map(x=>x.p);
}
function suggest(raw){
  const g=norm(raw); if(g.length<2) return [];
  const used=new Set(S.cells.filter(Boolean));
  return IDX.filter(x=>!used.has(x.p.name) && (x.f.startsWith(g) || x.s.startsWith(g) || x.f.includes(' '+g))).slice(0,6).map(x=>x.p.name);
}

let swallowUntil = 0;
document.addEventListener('pointerdown', ()=>{ swallowUntil = 0; }, true);
document.addEventListener('click', e=>{ if(performance.now() < swallowUntil){ swallowUntil = 0; e.preventDefault(); e.stopPropagation(); } }, true);
function onPress(el, fn){
  let fired = false;
  const off = () => el.disabled || el.getAttribute('aria-disabled')==='true';
  el.addEventListener('pointerdown', e=>{ if(e.button!==0 || off()) return; e.preventDefault();
    if(e.pointerType==='mouse') fired = true; else swallowUntil = performance.now() + 600; fn(); });
  el.addEventListener('click', ()=>{ if(fired){ fired=false; return; } if(!off()) fn(); });
}
